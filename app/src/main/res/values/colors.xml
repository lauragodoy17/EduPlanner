<?xml version="1.0" encoding="utf-8"?>
<!-- Colores fijos: no cambian con el tema. La paleta está en values/themes.xml (atributos de attrs_tema.xml)
     y se usa como ?attr/eduAcento en XML o R.color.acento en el código (res/color/). -->
<resources>
    <color name="black">#FF000000</color>
    <!-- Texto e iconos sobre el degradado de la marca, la cámara o el QR: blanco en todos los temas -->
    <color name="white">#FFFFFFFF</color>
    <color name="blanco_70">#B3FFFFFF</color>
    <color name="blanco_25">#40FFFFFF</color>

    <!-- Pantalla de carga: se muestra antes de saber el tema -->
    <color name="marca_lanzador">#4A1F5C</color>

    <!-- Monedas y logros: son "materiales", iguales en todos los temas -->
    <color name="xp_dorado">#FFC93C</color>
    <color name="logro_bronce">#B4764A</color>
    <color name="logro_plata">#7F8FA6</color>
    <color name="logro_oro">#D49B00</color>

    <!-- Botón de Google (solo en el inicio de sesión) -->
    <color name="google_border">#DADCE0</color>
</resources>
