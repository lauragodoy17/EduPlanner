        <item name="eduEvento">#A99CF6</item>
        <item name="eduEventoSuave">#29254A</item>
        <item name="eduLogroBloqueado">#3B3642</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Las superficies usan el color de la paleta tal cual, sin el aclarado por elevación de Material -->
        <item name="elevationOverlayEnabled">false</item>

        <item name="colorPrimary">?attr/eduAcento</item>
        <item name="colorPrimaryVariant">?attr/eduMarcaProfunda</item>
        <item name="colorOnPrimary">?attr/eduSobreAcento</item>
        <item name="colorSecondary">?attr/eduAcento</item>
        <item name="colorOnSecondary">?attr/eduSobreAcento</item>
        <item name="colorAccent">?attr/eduAcento</item>
        <item name="colorSurface">?attr/eduSuperficie</item>
        <item name="colorOnSurface">?attr/eduTextPrimary</item>
        <item name="colorOnBackground">?attr/eduTextPrimary</item>
        <item name="colorError">?attr/eduEstadoError</item>
        <item name="colorControlNormal">?attr/eduTextSecondary</item>
        <item name="colorControlActivated">?attr/eduAcento</item>
        <item name="android:colorBackground">?attr/eduFondoApp</item>
        <item name="android:windowBackground">?attr/eduFondoApp</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?attr/eduSuperficie</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="textAppearanceButton">@style/Edu.TextoBoton</item>
        <item name="shapeAppearanceSmallComponent">@style/Edu.FormaTarjeta</item>
        <item name="materialAlertDialogTheme">@style/Edu.TemaAlerta</item>
        <item name="popupMenuStyle">@style/Edu.MenuEmergente</item>
        <item name="snackbarStyle">@style/Edu.Aviso</item>
        <item name="snackbarTextViewStyle">@style/Edu.AvisoTexto</item>
        <item name="android:datePickerDialogTheme">@style/Edu.TemaSelector</item>
        <item name="android:timePickerDialogTheme">@style/Edu.TemaSelector</item>
    </style>

    <style name="Theme.APISplashScreen" parent="Theme.SplashScreen">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="windowSplashScreenBackground">@color/marca_lanzador</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.MyApplication</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>
</resources>
