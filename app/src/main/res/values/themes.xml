        <item name="eduSobreAcento">#FFFFFF</item>
        <item name="eduMarcaClara">#7FB0E8</item>
        <item name="eduMarcaSuave">#C6DCF7</item>
        <item name="eduMarcaSuperficie">#EAF2FD</item>
        <item name="eduDegradadoInicio">#0B3A66</item>
        <item name="eduDegradadoFin">#1A6FD6</item>
        <item name="eduFondoApp">#F3F7FB</item>
        <item name="eduSuperficie">#FFFFFF</item>
        <item name="eduBordeSuave">#DCE5EF</item>
        <item name="eduPistaClara">#E6ECF3</item>
        <item name="eduVeloOscuro">#660B3A66</item>
        <item name="eduTextPrimary">#172534</item>
        <item name="eduTextSecondary">#56677A</item>
        <item name="eduTextHint">#8593A3</item>
        <item name="eduEvento">#00838F</item>
        <item name="eduEventoSuave">#DFF3F4</item>
        <item name="eduLogroBloqueado">#D3DAE2</item>
    </style>

    <!-- Clásico: tonos verdes -->
    <style name="Tema.EduPlanner.Clasico" parent="Base.Theme.MyApplication">
        <item name="eduMarcaProfunda">#1B4D3E</item>
        <item name="eduMarca">#3A7D5C</item>
        <item name="eduAcento">#2E7D32</item>
        <item name="eduSobreAcento">#FFFFFF</item>
        <item name="eduMarcaClara">#8CC7A0</item>
        <item name="eduMarcaSuave">#C8E6C9</item>
        <item name="eduMarcaSuperficie">#EBF5EC</item>
        <item name="eduDegradadoInicio">#1B4D3E</item>
        <item name="eduDegradadoFin">#2E7D32</item>
        <item name="eduFondoApp">#F3F7F3</item>
        <item name="eduSuperficie">#FFFFFF</item>
        <item name="eduBordeSuave">#DCE7DD</item>
        <item name="eduPistaClara">#E5EDE6</item>
        <item name="eduVeloOscuro">#661B4D3E</item>
        <item name="eduTextPrimary">#1C2A21</item>
