        <item name="eduEventoSuave">#E8EAF6</item>
        <item name="eduLogroBloqueado">#D2DBD3</item>
    </style>

    <!-- Oscuro: fondos casi negros con un toque de la marca; parte de un tema oscuro para que los controles
         del sistema (menús, selectores de fecha y hora, casillas) también se vean oscuros -->
    <style name="Tema.EduPlanner.Oscuro" parent="Theme.MaterialComponents.NoActionBar">
        <item name="eduMarcaProfunda">#E9CFF2</item>
        <item name="eduMarca">#C9A3DB</item>
        <item name="eduAcento">#B66BD9</item>
        <item name="eduSobreAcento">#FFFFFF</item>
        <item name="eduMarcaClara">#8E6AA3</item>
        <item name="eduMarcaSuave">#4A3356</item>
        <item name="eduMarcaSuperficie">#2C2333</item>
        <item name="eduDegradadoInicio">#2A1238</item>
        <item name="eduDegradadoFin">#6A2C8A</item>
        <item name="eduFondoApp">#121017</item>
        <item name="eduSuperficie">#1E1B24</item>
        <item name="eduBordeSuave">#35303C</item>
        <item name="eduPistaClara">#2A2731</item>
        <item name="eduVeloOscuro">#B3000000</item>
        <item name="eduTextPrimary">#EEE8F2</item>
        <item name="eduTextSecondary">#B5ABBD</item>
        <item name="eduTextHint">#8A8192</item>
        <item name="eduEstadoExito">#73D19B</item>
        <item name="eduEstadoExitoSuave">#1C3326</item>
        <item name="eduEstadoAviso">#F4B860</item>
        <item name="eduEstadoAvisoSuave">#3A2E18</item>
        <item name="eduEstadoError">#FF8A94</item>
