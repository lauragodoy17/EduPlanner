<resources>
    <!--
        TEMAS. Cada tema da un valor a cada color de la paleta (values/attrs_tema.xml); las pantallas nunca usan
        un color fijo sino el atributo (?attr/eduAcento) o su selector (R.color.acento). Para añadir un tema:
        una paleta completa aquí, una entrada en domain/preferencias/TemaApp y su estilo en ui/tema/Temas.kt.
        El inicio de sesión, el registro y la pantalla de carga usan siempre Theme.MyApplication (claro).
    -->

    <!-- Claro: el tema original, morado -->
    <style name="Base.Theme.MyApplication" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="eduMarcaProfunda">#4A1F5C</item>
        <item name="eduMarca">#8B5A9F</item>
        <item name="eduAcento">#9C27B0</item>
        <item name="eduSobreAcento">#FFFFFF</item>
        <item name="eduMarcaClara">#B48BBF</item>
        <item name="eduMarcaSuave">#E1BEE7</item>
        <item name="eduMarcaSuperficie">#F3E5F5</item>
        <item name="eduDegradadoInicio">#4A1F5C</item>
        <item name="eduDegradadoFin">#9C27B0</item>
        <item name="eduFondoApp">#F7F4F9</item>
        <item name="eduSuperficie">#FFFFFF</item>
        <item name="eduBordeSuave">#E8E2EC</item>
        <item name="eduPistaClara">#EEEAF0</item>
        <item name="eduVeloOscuro">#664A1F5C</item>
        <item name="eduTextPrimary">#2B1E33</item>
        <item name="eduTextSecondary">#6A6072</item>
        <item name="eduTextHint">#8F8697</item>
        <item name="eduEstadoExito">#2E7D4F</item>
        <item name="eduEstadoExitoSuave">#E3F4E9</item>
        <item name="eduEstadoAviso">#A86400</item>
        <item name="eduEstadoAvisoSuave">#FFF3DC</item>
        <item name="eduEstadoError">#C62F3B</item>
        <item name="eduEstadoErrorSuave">#FCE8EA</item>
        <item name="eduEvento">#5E4BB8</item>
        <item name="eduEventoSuave">#ECE9FA</item>
        <item name="eduLogroBloqueado">#D6D2D9</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Lo común a todos los temas (repetido en Tema.EduPlanner.Oscuro, que parte de un tema oscuro) -->
        <item name="colorPrimary">?attr/eduAcento</item>
        <item name="colorPrimaryVariant">?attr/eduMarcaProfunda</item>
        <item name="colorOnPrimary">?attr/eduSobreAcento</item>
        <item name="colorSecondary">?attr/eduAcento</item>
        <item name="colorOnSecondary">?attr/eduSobreAcento</item>
        <item name="colorAccent">?attr/eduAcento</item>
        <item name="colorSurface">?attr/eduSuperficie</item>
        <item name="colorOnSurface">?attr/eduTextPrimary</item>
        <item name="colorOnBackground">?attr/eduTextPrimary</item>
        <item name="colorError">?attr/eduEstadoError</item>
        <item name="colorControlNormal">?attr/eduTextSecondary</item>
        <item name="colorControlActivated">?attr/eduAcento</item>
        <item name="android:colorBackground">?attr/eduFondoApp</item>
        <item name="android:windowBackground">?attr/eduFondoApp</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?attr/eduSuperficie</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="textAppearanceButton">@style/Edu.TextoBoton</item>
        <item name="shapeAppearanceSmallComponent">@style/Edu.FormaTarjeta</item>
        <item name="materialAlertDialogTheme">@style/Edu.TemaAlerta</item>
        <item name="popupMenuStyle">@style/Edu.MenuEmergente</item>
        <item name="snackbarStyle">@style/Edu.Aviso</item>
        <item name="snackbarTextViewStyle">@style/Edu.AvisoTexto</item>
        <item name="android:datePickerDialogTheme">@style/Edu.TemaSelector</item>
        <item name="android:timePickerDialogTheme">@style/Edu.TemaSelector</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication"/>

    <!-- Login y registro: el degradado cubre toda la pantalla, también bajo las barras del sistema -->
    <style name="Theme.MyApplication.Acceso">
        <item name="android:statusBarColor">?attr/eduMarcaProfunda</item>
        <item name="android:navigationBarColor">?attr/eduFondoApp</item>
    </style>

    <!-- ===== Temas que se eligen en Opciones > Tema de la app ===== -->
    <style name="Tema.EduPlanner.Claro" parent="Base.Theme.MyApplication"/>

    <!-- Azul -->
    <style name="Tema.EduPlanner.Azul" parent="Base.Theme.MyApplication">
        <item name="eduMarcaProfunda">#0B3A66</item>
        <item name="eduMarca">#2F6FAD</item>
