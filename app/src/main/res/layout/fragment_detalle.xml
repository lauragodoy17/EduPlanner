<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de un evento, asignatura o calificación: la tarjeta con su información y las acciones arriba a la derecha -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/eduFondoApp"
    android:fillViewport="true"
    tools:context=".ui.Inicio.Fragments.Detalle.DetalleFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margen_pantalla"
        android:paddingTop="20dp"
        android:paddingBottom="96dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/detalleTarjeta"
            style="@style/Edu.Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Imagen del evento, si tiene -->
                <ImageView
                    android:id="@+id/detalleImagen"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/detalleEtiqueta"
                            style="@style/Edu.Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="EVENTO"/>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>

                        <include
                            android:id="@+id/detalleAcciones"
                            layout="@layout/include_acciones_detalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="-8dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detalleTitulo"
                        style="@style/Edu.Texto.TituloHoja"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp"
                        android:textAlignment="viewStart"
                        tools:text="Feria de ciencias"/>

                    <TextView
                        android:id="@+id/detalleLabelDescripcion"
                        style="@style/Edu.Texto.Rotulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="Descripción"/>

                    <TextView
                        android:id="@+id/detalleDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:textColor="?attr/eduTextPrimary"
                        android:textSize="15sp"
                        tools:text="Stand 4 del coliseo"/>

                    <!-- Filas rótulo → valor (item_info_detalle) -->
                    <LinearLayout
                        android:id="@+id/detalleFilas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/time_row_bg"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="7dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/detalleNoExiste"
            style="@style/Edu.Texto.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Esto ya no existe: puede que se haya borrado."
            android:visibility="gone"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
