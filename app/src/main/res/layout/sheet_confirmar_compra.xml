<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/compraTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar compra"
            android:textAlignment="center"
            android:textColor="#1A1A1A"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Vista previa sobre el avatar -->
        <com.softcg.myapplication.ui.Inicio.Fragments.Perfil.AvatarView
            android:id="@+id/compraAvatar"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/compraNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accesorio"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_coin"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/compraPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50 EduCoins"
                android:textColor="@color/purple_accent"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/purple_surface">

            <TextView
                android:id="@+id/compraSaldo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Tu saldo: 100 · Te quedarán: 50"
                android:textAlignment="center"
                android:textColor="#333333"
                android:textSize="14sp"/>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonComprar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Comprar"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            app:backgroundTint="@color/purple_accent"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            android:layout_marginBottom="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonCancelarCompra"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Cancelar"
            android:textColor="@color/purple_accent"
            android:textSize="17sp"
            android:textStyle="bold"
            app:strokeColor="@color/purple_accent"
            app:strokeWidth="2dp"
            app:cornerRadius="16dp"/>

    </LinearLayout>

</ScrollView>
