<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/misionIcono"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="@color/purple_surface"
                android:src="@drawable/ic_gami_objetivo"
                app:tint="@color/purple_accent"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/misionTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Misión"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/misionDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descripción de la misión"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/misionRecompensa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_coin"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:id="@+id/misionRecompensaTexto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+10"
                    android:textColor="@color/purple_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/misionHecha"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="4dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="@color/purple_accent"
                android:src="@drawable/ic_gami_check"
                app:tint="@color/white"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:importantForAccessibility="no"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/misionBarra"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:trackThickness="6dp"
                app:trackCornerRadius="3dp"
                app:indicatorColor="@color/purple_accent"
                app:trackColor="@color/pista_clara"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/misionAvance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/misionReclamar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Reclamar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/purple_accent"
            app:cornerRadius="16dp"
            app:elevation="0dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
