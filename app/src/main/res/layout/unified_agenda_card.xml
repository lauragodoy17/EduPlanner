<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de tarea o evento. Es la misma en Inicio (dentro de la línea de tiempo) y en Agenda. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Edu.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="4dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/item_icono"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="?attr/eduMarcaSuperficie"
                android:src="@drawable/ic_gami_tarea"
                app:tint="?attr/eduAcento"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_titulo"
                    style="@style/Edu.Texto.TituloTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Título del elemento" />

                <TextView
                    android:id="@+id/texto_asignatura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Asignatura"
                    android:textSize="13sp"
                    android:textColor="?attr/eduAcento"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textodesc"
                    style="@style/Edu.Texto.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Descripción del elemento" />
            </LinearLayout>

            <ImageView
                android:id="@+id/opciones"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Opciones"
                android:src="@drawable/ic_more_vert"
                app:tint="?attr/eduTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/item_type_badge"
                style="@style/Edu.Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAREA" />

            <View
                android:id="@+id/priority_indicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_shape"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/prioridad_texto"
                style="@style/Edu.Texto.Pie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Media" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/textofecha"
                style="@style/Edu.Texto.Pie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25/09/2025" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
