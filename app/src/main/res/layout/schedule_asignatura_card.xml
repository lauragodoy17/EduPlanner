<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="?attr/eduSuperficie"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <View
            android:id="@+id/card_color_bar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_barra_color"
            android:backgroundTint="?attr/eduAcento"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_asignatura_nombre"
                style="@style/Edu.Texto.TituloTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre de Asignatura"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_hora_rango"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="08:30 - 10:30"
                android:textSize="12sp"
                android:textColor="?attr/eduAcento"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/text_tutor"
                style="@style/Edu.Texto.Pie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profesor"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_duracion"
            style="@style/Edu.Texto.Pie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="2h"
            android:background="@drawable/duration_badge_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
