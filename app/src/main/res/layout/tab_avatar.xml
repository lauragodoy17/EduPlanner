<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="96dp">

        <com.softcg.myapplication.ui.Inicio.Fragments.Perfil.AvatarView
            android:id="@+id/avatarVistaPrevia"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tono de piel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:id="@+id/avatarTonosPiel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Color de pelo"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:id="@+id/avatarTonosPelo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonTienda"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Ir a la tienda"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            app:backgroundTint="@color/purple_accent"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            style="@style/TituloSeccionProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mis accesorios"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toca un accesorio para ponérselo o quitárselo a tu avatar"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/perfilInventarioVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aún no tienes accesorios. ¡Gana EduCoins y visita la tienda!"
            android:textColor="@color/text_hint"
            android:textSize="14sp"
            android:paddingVertical="16dp"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/perfilInventario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
