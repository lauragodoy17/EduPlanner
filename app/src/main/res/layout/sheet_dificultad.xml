<?xml version="1.0" encoding="utf-8"?>
<!-- Pregunta corta de dificultad percibida (al entregar una tarea o desde el panel de datos) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_a"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <View style="@style/Edu.AsaHoja"/>

    <TextView
        android:id="@+id/dificultadTitulo"
        style="@style/Edu.Texto.TituloHoja"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        tools:text="¿Qué tan difícil fue?"/>

    <TextView
        android:id="@+id/dificultadDetalle"
        style="@style/Edu.Texto.Cuerpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        tools:text="Ensayo de historia · Historia"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/dificultadOpciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:singleSelection="true"/>

    <TextView
        style="@style/Edu.Texto.Pie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="Tu respuesta ayuda a predecir qué temas necesitas reforzar."/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dificultadGuardar"
        style="@style/Edu.Boton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/alto_boton"
        android:enabled="false"
        android:text="Guardar"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dificultadOmitir"
        style="@style/Edu.BotonTexto"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Omitir"/>
</LinearLayout>
