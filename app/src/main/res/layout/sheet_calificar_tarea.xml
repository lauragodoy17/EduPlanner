<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <View style="@style/Edu.AsaHoja"/>

        <TextView
            style="@style/Edu.Texto.TituloHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calificar tarea"
            android:layout_marginBottom="16dp"/>

        <androidx.cardview.widget.CardView
            style="@style/Edu.Tarjeta.Plana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/calificarTitulo"
                    style="@style/Edu.Texto.TituloTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tarea"/>

                <TextView
                    android:id="@+id/calificarAsignatura"
                    style="@style/Edu.Texto.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Asignatura"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/calificarValorContainer"
            style="@style/Edu.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Calificación obtenida">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/calificarValor"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_coin"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/calificarRecompensa"
                style="@style/Edu.Texto.Pie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:text="Al registrar la calificación la tarea queda completada (+5 EduCoins)"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonCalificar"
            style="@style/Edu.Boton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_boton"
            android:text="Guardar calificación"/>
    </LinearLayout>
</ScrollView>
