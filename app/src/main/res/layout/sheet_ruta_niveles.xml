<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_a"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ruta de niveles"
        android:textColor="#1A1A1A"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/rutaResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 XP acumulados"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/rutaLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rutaCerrar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="Cerrar"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        app:backgroundTint="@color/purple_accent"
        app:cornerRadius="16dp"
        app:elevation="0dp"/>
</LinearLayout>
