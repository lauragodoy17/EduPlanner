<?xml version="1.0" encoding="utf-8"?>
<!-- QR de una tarea, evento, asignatura o nota para que otro estudiante lo lea con "Leer QR" -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <View style="@style/Edu.AsaHoja"/>

        <TextView
            android:id="@+id/compartirTipo"
            style="@style/Edu.Texto.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            tools:text="COMPARTIR TAREA"/>

        <TextView
            android:id="@+id/compartirTitulo"
            style="@style/Edu.Texto.TituloHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            tools:text="Taller de integrales"/>

        <TextView
            android:id="@+id/compartirResumen"
            style="@style/Edu.Texto.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            tools:text="Cálculo · 20/11/2026"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/radio_tarjeta"
            app:cardElevation="0dp"
            app:strokeColor="?attr/eduMarcaSuave"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/compartirQr"
                android:layout_width="248dp"
                android:layout_height="248dp"
                android:layout_margin="14dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"/>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/time_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/baseline_qr_code_24"
                app:tint="?attr/eduAcento"/>

            <TextView
                style="@style/Edu.Texto.Cuerpo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="En el otro teléfono, abre EduPlanner, toca + y elige «Leer QR». Tu compañero podrá revisarlo antes de agregarlo."/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/compartirListo"
            style="@style/Edu.Boton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_boton"
            android:text="Listo"/>
    </LinearLayout>
</ScrollView>
