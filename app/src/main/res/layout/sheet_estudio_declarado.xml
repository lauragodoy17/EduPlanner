<?xml version="1.0" encoding="utf-8"?>
<!-- Tiempo de estudio de una asignatura: un solo ítem en "Datos para predicciones", dos preguntas aquí -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <View style="@style/Edu.AsaHoja"/>

        <TextView
            style="@style/Edu.Texto.TituloHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Tiempo y método de estudio"/>

        <TextView
            android:id="@+id/estudioAsignatura"
            style="@style/Edu.Texto.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            tools:text="Cálculo II"/>

        <TextView
            style="@style/Edu.Texto.Rotulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="¿Cuántas horas a la semana estudias esta asignatura?"/>

        <TextView
            style="@style/Edu.Texto.Pie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Fuera de clase. Cuando tengas dos semanas de sesiones registradas se usarán esas."/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/estudioHorasCaja"
            style="@style/Edu.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Horas por semana">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/estudioHoras"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:maxLength="5"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Edu.Texto.Rotulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="¿Con qué método la estudias normalmente?"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Edu.CampoDesplegable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Método de estudio">

            <AutoCompleteTextView
                android:id="@+id/estudioMetodo"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:padding="16dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/estudioError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="?attr/eduEstadoError"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Indica entre 0 y 40 horas por semana"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/estudioGuardar"
            style="@style/Edu.Boton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_boton"
            android:layout_marginTop="4dp"
            android:text="Guardar"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/estudioAhoraNo"
            style="@style/Edu.BotonTexto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Ahora no"/>
    </LinearLayout>
</ScrollView>
