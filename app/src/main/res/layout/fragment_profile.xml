<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.Inicio.Fragments.Perfil.ProfileFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="0dp">

        <!-- Nivel, XP y resumen: se oculta al desplazar para dejar sitio al contenido -->
        <LinearLayout
            android:id="@+id/perfilHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hero_progreso"
            android:padding="20dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ver la ruta de niveles"
            app:layout_scrollFlags="scroll">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginEnd="16dp">

                    <com.softcg.myapplication.ui.Inicio.Fragments.Perfil.Views.AnilloProgresoView
                        android:id="@+id/perfilAnillo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <com.softcg.myapplication.ui.Inicio.Fragments.Perfil.AvatarView
                        android:id="@+id/perfilAvatar"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/perfilNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="usuario"
                        android:textColor="@color/blanco_70"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/perfilNivelNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Primíparo"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/perfilNivelEtiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NIVEL 1"
                        android:textColor="@color/xp_dorado"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/perfilXp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Faltan 60 XP para Organizado"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/blanco_70"
                    android:importantForAccessibility="no"/>
            </LinearLayout>

            <!-- Racha, saldo y logros -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_pastilla_translucida"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_gami_racha"
                            app:tint="@color/xp_dorado"
                            android:layout_marginEnd="4dp"
                            android:importantForAccessibility="no"/>

                        <TextView
                            android:id="@+id/perfilRacha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Días de racha"
                        android:textColor="@color/blanco_70"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_pastilla_translucida"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_coin"
                            android:layout_marginEnd="4dp"
                            android:importantForAccessibility="no"/>

                        <TextView
                            android:id="@+id/perfilSaldo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EduCoins"
                        android:textColor="@color/blanco_70"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_pastilla_translucida"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_gami_trofeo"
                            app:tint="@color/xp_dorado"
                            android:layout_marginEnd="4dp"
                            android:importantForAccessibility="no"/>

                        <TextView
                            android:id="@+id/perfilLogros"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/0"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Logros"
                        android:textColor="@color/blanco_70"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/perfilTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabPaddingStart="2dp"
            app:tabPaddingEnd="2dp"
            app:tabIndicatorColor="@color/purple_accent"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/purple_accent"
            app:tabTextColor="@color/text_secondary"
            app:tabTextAppearance="@style/TextoPestanaProgreso"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/perfilPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
