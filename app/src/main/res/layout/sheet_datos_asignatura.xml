<?xml version="1.0" encoding="utf-8"?>
<!-- Datos de una asignatura que alimentan las predicciones: área, escala de notas, interés y método -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <View style="@style/Edu.AsaHoja"/>

        <TextView
            android:id="@+id/datosTitulo"
            style="@style/Edu.Texto.TituloHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            tools:text="Cálculo II"/>

        <TextView
            style="@style/Edu.Texto.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="Con estos datos EduPlanner puede predecir cómo vas en cada tema y qué método te conviene. Todo es opcional."/>

        <TextView
            style="@style/Edu.Texto.Rotulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="¿A qué área pertenece?"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Edu.CampoDesplegable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Área">

            <AutoCompleteTextView
                android:id="@+id/datosArea"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:padding="16dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/datosAreaSugerida"
            style="@style/Edu.Texto.Pie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            tools:text="Sugerida por el nombre de la asignatura"
            tools:visibility="visible"/>

        <LinearLayout
            android:id="@+id/datosEscala"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/Edu.Texto.Rotulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="Escala de tus notas"/>

            <TextView
                android:id="@+id/datosEscalaDetalle"
                style="@style/Edu.Texto.Pie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                tools:text="El tipo de calificación no indica un rango. Por ejemplo, de 1 a 5."/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/datosEscalaMinCaja"
                    style="@style/Edu.Campo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="Nota mínima">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/datosEscalaMin"
                        style="@style/Edu.CampoEntrada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/datosEscalaMaxCaja"
                    style="@style/Edu.Campo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:hint="Nota máxima">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/datosEscalaMax"
                        style="@style/Edu.CampoEntrada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Edu.Texto.Rotulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="¿Cuánto te interesa esta asignatura?"/>

        <TextView
            android:id="@+id/datosInteresDetalle"
            style="@style/Edu.Texto.Pie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Puedes cambiar la respuesta cuando cambie tu interés."/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/datosInteres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:singleSelection="true"/>

        <TextView
            style="@style/Edu.Texto.Rotulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="¿Cómo estudias normalmente esta asignatura?"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Edu.CampoDesplegable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Método de estudio">

            <AutoCompleteTextView
                android:id="@+id/datosMetodo"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:padding="16dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/datosError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="@color/estado_error"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="El máximo de la escala debe ser mayor que el mínimo"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/datosGuardar"
            style="@style/Edu.Boton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_boton"
            android:layout_marginTop="4dp"
            android:text="Guardar"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/datosAhoraNo"
            style="@style/Edu.BotonTexto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Ahora no"/>
    </LinearLayout>
</ScrollView>
