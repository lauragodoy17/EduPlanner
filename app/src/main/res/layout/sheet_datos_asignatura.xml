<?xml version="1.0" encoding="utf-8"?>
<!-- Datos de una asignatura que alimentan las predicciones: área y escala de notas (solo lo que falta) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <View style="@style/Edu.AsaHoja"/>

        <TextView
            android:id="@+id/datosTitulo"
            style="@style/Edu.Texto.TituloHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            tools:text="Cálculo II"/>

        <TextView
            style="@style/Edu.Texto.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="Con estos datos EduPlanner puede predecir cómo vas en cada tema y qué método te conviene."/>

        <TextView
            style="@style/Edu.Texto.Rotulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="¿A qué área pertenece?"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Edu.CampoDesplegable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Área">

            <AutoCompleteTextView
                android:id="@+id/datosArea"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:padding="16dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/datosAreaSugerida"
            style="@style/Edu.Texto.Pie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            tools:text="Sugerida por el nombre de la asignatura"
            tools:visibility="visible"/>

        <!-- Solo en asignaturas antiguas sin escala de notas (las nuevas la eligen al crearse) -->
        <LinearLayout
            android:id="@+id/datosEscala"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <include
                layout="@layout/include_selector_escala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            android:id="@+id/datosError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="?attr/eduEstadoError"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="El máximo de la escala debe ser mayor que el mínimo"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/datosGuardar"
            style="@style/Edu.Boton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_boton"
            android:layout_marginTop="4dp"
            android:text="Guardar"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/datosAhoraNo"
            style="@style/Edu.BotonTexto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Ahora no"/>
    </LinearLayout>
</ScrollView>
