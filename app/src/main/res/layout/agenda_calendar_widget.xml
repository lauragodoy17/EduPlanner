<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Mes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:id="@+id/btn_previous_month"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="?attr/eduAcento"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:contentDescription="Mes anterior" />

            <TextView
                android:id="@+id/tv_month_year"
                style="@style/Edu.Texto.TituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enero 2024"
                android:textSize="16sp"
                android:gravity="center" />

            <ImageView
                android:id="@+id/btn_next_month"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/eduAcento"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:contentDescription="Mes siguiente" />

            <ImageView
                android:id="@+id/btn_expand_collapse"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_expand_more"
                app:tint="?attr/eduAcento"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:rotation="0"
                android:contentDescription="Expandir o contraer el mes" />
        </LinearLayout>

        <!-- Días de la semana -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <TextView style="@style/Edu.Texto.Rotulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="L" android:gravity="center" />
            <TextView style="@style/Edu.Texto.Rotulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="M" android:gravity="center" />
            <TextView style="@style/Edu.Texto.Rotulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="M" android:gravity="center" />
            <TextView style="@style/Edu.Texto.Rotulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="J" android:gravity="center" />
            <TextView style="@style/Edu.Texto.Rotulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="V" android:gravity="center" />
            <TextView style="@style/Edu.Texto.Rotulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" android:gravity="center" />
            <TextView style="@style/Edu.Texto.Rotulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="D" android:gravity="center" />
        </LinearLayout>

        <!-- Semanas: se agregan desde el código -->
        <LinearLayout
            android:id="@+id/calendar_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</merge>
