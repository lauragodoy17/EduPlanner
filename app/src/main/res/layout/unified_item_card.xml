<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:baselineAligned="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- Línea de tiempo -->
    <LinearLayout
        android:layout_width="16dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:id="@+id/timeline_line_top"
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:background="?attr/eduMarcaSuave" />

        <View
            android:id="@+id/timeline_circle"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="?attr/eduAcento" />

        <View
            android:id="@+id/timeline_line_bottom"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/eduMarcaSuave" />
    </LinearLayout>

    <include
        layout="@layout/unified_agenda_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="2dp"
        android:layout_marginVertical="5dp" />
</LinearLayout>
