<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <com.softcg.myapplication.ui.Inicio.Fragments.Perfil.Views.ConfettiView
        android:id="@+id/subidaConfeti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>

    <LinearLayout
        android:id="@+id/subidaTarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="32dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_tarjeta_degradada"
        android:elevation="12dp"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUBISTE DE NIVEL"
            android:textColor="@color/xp_dorado"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"/>

        <TextView
            android:id="@+id/subidaNumero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2"
            android:textColor="@color/white"
            android:textSize="84sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:layout_marginVertical="4dp"/>

        <TextView
            android:id="@+id/subidaNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Organizado"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pastilla_translucida"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_coin"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/subidaRecompensa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+20 EduCoins"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/subidaDesbloqueos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ya disponible en la tienda: Audífonos"
            android:textAlignment="center"
            android:textColor="@color/blanco_70"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/subidaContinuar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:text="Continuar"
            android:textColor="@color/purple_deep"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            app:elevation="0dp"/>
    </LinearLayout>
</FrameLayout>
