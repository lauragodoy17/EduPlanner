<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#F5F5F5"
    tools:context=".ui.Inicio.Fragments.Home.HomeFragment">


    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Resumen de progreso: lleva al perfil -->
        <LinearLayout
            android:id="@+id/homeProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_tarjeta_degradada"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ver tu progreso"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/homeProgresoNivel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="@color/xp_dorado"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/purple_deep"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/homeProgresoNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Primíparo"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/homeProgresoBarra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    app:trackThickness="4dp"
                    app:trackCornerRadius="2dp"
                    app:indicatorColor="@color/xp_dorado"
                    app:trackColor="@color/blanco_25"
                    android:importantForAccessibility="no"/>
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_gami_racha"
                app:tint="@color/xp_dorado"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/homeProgresoRacha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp"/>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_gami_objetivo"
                app:tint="@color/xp_dorado"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/homeProgresoMisiones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/3 hoy"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Date Filter Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calendario"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#9C27B0"
                android:gravity="center"
                android:layout_marginBottom="12dp"
                android:paddingVertical="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filtrar por fecha"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_date_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/textoeventos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eventos"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#949494"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textoclases"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tareas"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#949494"
                android:visibility="gone" />

        </LinearLayout>

        <!-- VERSION A: Content Area (with events/tasks) -->
        <ScrollView
            android:id="@+id/version_a_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Timeline Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tareas y Eventos"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#9C27B0" />

                        <Spinner
                            android:id="@+id/filter_spinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:minHeight="32dp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_timeline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:layout_marginBottom="16dp" />

                </LinearLayout>

                <!-- Container for RecyclerViews (preserving existing functionality) -->
                <LinearLayout
                    android:id="@+id/container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerclases"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclereventos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- VERSION B: Empty State -->
        <LinearLayout
            android:id="@+id/version_b_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="32dp">

            <!-- Empty State Image Placeholder -->
            <androidx.cardview.widget.CardView
                android:layout_width="180dp"
                android:layout_height="180dp"
                app:cardCornerRadius="90dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="32dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E8E8E8">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="📚"
                        android:textSize="48sp" />

                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <!-- Empty message for tasks -->
            <TextView
                android:id="@+id/textonoclases"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No tienes tareas pendientes"
                android:textSize="18sp"
                android:textColor="@color/purple_accent"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <!-- Empty message for events -->
            <TextView
                android:id="@+id/textonoeventos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No tienes eventos pendientes"
                android:textSize="18sp"
                android:textColor="@color/purple_accent"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Haz clic en el botón del +"
                android:textSize="16sp"
                android:textColor="#7B68EE"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>


</LinearLayout>