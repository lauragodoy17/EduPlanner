<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.Inicio.Fragments.Home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margen_pantalla"
        android:paddingTop="16dp"
        android:paddingBottom="88dp">

        <!-- Resumen de progreso: lleva al perfil -->
        <LinearLayout
            android:id="@+id/homeProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_tarjeta_degradada"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ver tu progreso"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/homeProgresoNivel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="@color/xp_dorado"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/purple_deep"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/homeProgresoNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Primíparo"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/homeProgresoBarra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    app:trackThickness="4dp"
                    app:trackCornerRadius="2dp"
                    app:indicatorColor="@color/xp_dorado"
                    app:trackColor="@color/blanco_25"
                    android:importantForAccessibility="no"/>
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_gami_racha"
                app:tint="@color/xp_dorado"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/homeProgresoRacha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp"/>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_gami_objetivo"
                app:tint="@color/xp_dorado"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/homeProgresoMisiones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/3 hoy"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Días -->
        <TextView
            android:id="@+id/homeFechaTitulo"
            style="@style/Edu.Texto.Seccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hoy"
            android:layout_marginBottom="10dp"
            android:accessibilityHeading="true"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_date_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="20dp" />

        <!-- Lista del día -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                style="@style/Edu.Texto.Rotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tareas y eventos" />

            <Spinner
                android:id="@+id/filter_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/filter_spinner_background"
                android:contentDescription="Filtrar por tipo"
                android:paddingEnd="26dp"
                android:minHeight="36dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Con elementos -->
            <LinearLayout
                android:id="@+id/version_a_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- Sin elementos -->
            <LinearLayout
                android:id="@+id/version_b_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:paddingVertical="24dp">

                <ImageView style="@style/Edu.VacioIcono" android:src="@drawable/ic_gami_tarea"/>

                <TextView
                    style="@style/Edu.VacioTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Día despejado" />

                <TextView
                    style="@style/Edu.VacioDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usa el botón + para añadir una tarea o un evento" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
