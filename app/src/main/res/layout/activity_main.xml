<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true"
    tools:context=".ui.login.MainActivity"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Marca -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:minHeight="200dp"
            android:paddingVertical="20dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/logoblanco"
                android:importantForAccessibility="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Regresaste!"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu semestre te estaba esperando"
                android:textColor="@color/blanco_70"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hoja_login"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoemail"
                style="@style/Edu.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/Email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailText"
                    style="@style/Edu.CampoEntrada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campocontrasea"
                style="@style/Edu.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/Contraseña"
                android:layout_marginBottom="4dp"
                android:minHeight="56dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:endIconMode="password_toggle"
                app:endIconTint="?attr/eduTextSecondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/contrasenaText"
                    style="@style/Edu.CampoEntrada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/textoolvido"
                style="@style/Edu.Texto.Enlace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:gravity="center_vertical"
                android:text="¿Olvidaste tu contraseña?"
                android:layout_gravity="end"
                android:layout_marginBottom="12dp"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botoningresar"
                style="@style/Edu.Boton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/alto_boton"
                android:text="Ingresar"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/eduBordeSuave"/>

                <TextView
                    style="@style/Edu.Texto.Pie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:text="o"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/eduBordeSuave"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_google"
                android:layout_width="match_parent"
                android:layout_height="@dimen/alto_boton"
                android:background="@drawable/button_google"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_google"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/textoGoogle"
                    style="@style/Edu.Texto.TituloTarjeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_google" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/textoregistro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal">

                <TextView
                    android:id="@+id/textonotiene"
                    style="@style/Edu.Texto.Cuerpo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿No tienes una cuenta? " />

                <TextView
                    android:id="@+id/textoregistrar"
                    style="@style/Edu.Texto.Enlace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center_vertical"
                    android:text="Regístrate"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
