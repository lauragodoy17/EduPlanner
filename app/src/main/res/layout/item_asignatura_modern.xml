<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_card"
    style="@style/Edu.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="14dp"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <!-- Color que identifica la asignatura -->
        <View
            android:id="@+id/card_color_bar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_barra_color"
            android:backgroundTint="@color/purple_accent"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_titulo"
                style="@style/Edu.Texto.TituloTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre de Asignatura"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/textodesc"
                style="@style/Edu.Texto.Cuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profesor"
                android:layout_marginBottom="10dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/purple_accent"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/text_hora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="08:30"
                    android:textSize="13sp"
                    android:textColor="@color/purple_accent"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/text_duracion"
                    style="@style/Edu.Texto.Pie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2h"
                    android:background="@drawable/duration_badge_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/circleImage"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/baseline_calendar_month_24"
                    app:tint="@color/text_secondary"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/text_dias"
                    style="@style/Edu.Texto.Pie"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lun, Mar, Mié"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Progreso de los datos para predicciones; abre el panel de la asignatura -->
            <LinearLayout
                android:id="@+id/datos_prediccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ia_destello"
                    app:tint="@color/purple_accent" />

                <TextView
                    android:id="@+id/text_datos_prediccion"
                    style="@style/Edu.Texto.Enlace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:text="Datos para predicciones: 5/7" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/Opciones"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Opciones"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
