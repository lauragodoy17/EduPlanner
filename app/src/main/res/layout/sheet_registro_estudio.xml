<?xml version="1.0" encoding="utf-8"?>
<!-- Registrar estudio hecho fuera del temporizador: cuenta para las predicciones, no da EduCoins -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <View style="@style/Edu.AsaHoja"/>

        <TextView
            style="@style/Edu.Texto.TituloHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Registrar estudio"/>

        <TextView
            style="@style/Edu.Texto.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="Para el tiempo que estudiaste sin el temporizador (biblioteca, grupo de estudio…). Cuenta para tus predicciones, no da EduCoins."/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/registroAsignaturaCaja"
            style="@style/Edu.CampoDesplegable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Asignatura">

            <AutoCompleteTextView
                android:id="@+id/registroAsignatura"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:padding="16dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/registroFechaCaja"
            style="@style/Edu.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha"
            app:endIconDrawable="@drawable/baseline_calendar_month_24"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registroFecha"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/registroMinutosCaja"
            style="@style/Edu.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Minutos de estudio">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registroMinutos"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Edu.CampoDesplegable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Método de estudio (opcional)">

            <AutoCompleteTextView
                android:id="@+id/registroMetodo"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:padding="16dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/registroError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="?attr/eduEstadoError"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Solo puedes registrar estudio de los últimos 7 días"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/registroGuardar"
            style="@style/Edu.Boton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_boton"
            android:text="Guardar"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/registroCancelar"
            style="@style/Edu.BotonTexto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Cancelar"/>
    </LinearLayout>
</ScrollView>
