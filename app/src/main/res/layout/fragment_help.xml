<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.Inicio.Fragments.Ayuda.HelpFragment">

    <LinearLayout
        android:id="@+id/containerManual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margen_pantalla"
        android:paddingTop="20dp"
        android:paddingBottom="88dp">

        <ImageView
            style="@style/Edu.VacioIcono"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:padding="18dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/baseline_question_mark_24"/>

        <TextView
            android:id="@+id/Conoce"
            style="@style/Edu.Texto.TituloHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Algo no funciona bien?"
            android:layout_marginBottom="4dp"/>

        <TextView
            style="@style/Edu.VacioDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cuéntanos qué pasó y te ayudaremos"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Edu.CampoDesplegable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tipo de queja">

            <AutoCompleteTextView
                android:id="@+id/QuejaEditText"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Edu.CampoDesplegable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Problema">

            <AutoCompleteTextView
                android:id="@+id/QuejadosEditText"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/DescripcionContainer"
            style="@style/Edu.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción del problema"
            app:counterEnabled="true"
            app:counterMaxLength="200">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/DescripcionEditText"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:maxLength="200"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonAgregar"
            style="@style/Edu.Boton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_boton"
            android:text="Enviar"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
