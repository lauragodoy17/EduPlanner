<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/detalleInsignia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_gami_insignia"
                app:tint="@color/logro_bloqueado"
                android:importantForAccessibility="no"/>

            <ImageView
                android:id="@+id/detalleIcono"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_gami_estrella"
                app:tint="@color/white"
                android:importantForAccessibility="no"/>
        </FrameLayout>

        <TextView
            android:id="@+id/detalleRareza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BRONCE"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/detalleTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logro"
            android:textAlignment="center"
            android:textColor="#1A1A1A"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/detalleDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textAlignment="center"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/detalleBarra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:trackThickness="8dp"
            app:trackCornerRadius="4dp"
            app:indicatorColor="@color/purple_accent"
            app:trackColor="@color/pista_clara"
            android:layout_marginBottom="6dp"
            android:importantForAccessibility="no"/>

        <TextView
            android:id="@+id/detalleAvance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 de 1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/detalleRecompensa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pastilla_superficie"
            android:padding="14dp"
            android:text="+10 EduCoins"
            android:textAlignment="center"
            android:textColor="@color/purple_deep"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detalleCerrar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Entendido"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            app:backgroundTint="@color/purple_accent"
            app:cornerRadius="16dp"
            app:elevation="0dp"/>
    </LinearLayout>
</ScrollView>
