<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusableInTouchMode="true"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <View style="@style/Edu.AsaHoja"/>

        <TextView
            android:id="@+id/formTitulo"
            style="@style/Edu.Texto.TituloHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar calificación"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/AsignaturaContainer"
            style="@style/Edu.CampoDesplegable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Asignatura">

            <AutoCompleteTextView
                android:id="@+id/AsignaturaEditText"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Hasta elegir la asignatura no se sabe la escala -->
        <TextView
            android:id="@+id/calificacionSinAsignatura"
            style="@style/Edu.Texto.Pie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Elige la asignatura: la calificación se registra con su escala de notas."/>

        <!-- Solo en asignaturas antiguas que aún no tienen escala: se elige una vez -->
        <LinearLayout
            android:id="@+id/calificacionEscalaPendiente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <include
                layout="@layout/include_selector_escala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <include
            layout="@layout/include_entrada_calificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/DescripcionContainer"
            style="@style/Edu.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción (opcional)"
            app:counterEnabled="true"
            app:counterMaxLength="200">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/DescripcionEditText"
                style="@style/Edu.CampoEntrada"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:maxLength="200"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonAgregar"
            style="@style/Edu.Boton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_boton"
            android:text="Agregar calificación"/>
    </LinearLayout>
</ScrollView>
