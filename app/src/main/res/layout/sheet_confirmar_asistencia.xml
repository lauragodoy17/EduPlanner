<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <View style="@style/Edu.AsaHoja"/>

        <TextView
            style="@style/Edu.Texto.TituloHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Asististe a esta clase?"
            android:layout_marginBottom="16dp"/>

        <androidx.cardview.widget.CardView
            style="@style/Edu.Tarjeta.Plana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/asistenciaAsignatura"
                    style="@style/Edu.Texto.TituloTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:text="Asignatura"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/baseline_calendar_month_24"
                        app:tint="?attr/eduAcento"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"/>

                    <TextView
                        android:id="@+id/asistenciaFecha"
                        style="@style/Edu.Texto.Cuerpo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_clock"
                        app:tint="?attr/eduAcento"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"/>

                    <TextView
                        android:id="@+id/asistenciaHorario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14:00 – 16:00"
                        android:textColor="?attr/eduAcento"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_coin"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/asistenciaRecompensa"
                style="@style/Edu.Texto.TituloTarjeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+10 EduCoins si asististe"/>
        </LinearLayout>

        <TextView
            android:id="@+id/asistenciaPlazo"
            style="@style/Edu.Texto.Pie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Puedes responder hasta la medianoche (12:00 a. m.)"
            android:textAlignment="center"
            android:layout_marginBottom="18dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonAsisti"
            style="@style/Edu.Boton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_boton"
            android:text="Sí, asistí"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonNoAsisti"
            style="@style/Edu.BotonContorno"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_boton"
            android:text="No asistí"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonMasTarde"
            style="@style/Edu.BotonTexto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Responder más tarde"/>
    </LinearLayout>
</ScrollView>
