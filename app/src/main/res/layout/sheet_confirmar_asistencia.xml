<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Asististe a esta clase?"
            android:textAlignment="center"
            android:textColor="#1A1A1A"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- Datos de la clase -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/purple_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/purple_accent"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/asistenciaAsignatura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Asignatura"
                        android:textColor="#333333"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/baseline_calendar_month_24"
                            app:tint="@color/purple_accent"
                            android:layout_marginEnd="6dp"
                            android:importantForAccessibility="no"/>

                        <TextView
                            android:id="@+id/asistenciaFecha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fecha"
                            android:textColor="#666666"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/purple_accent"
                            android:layout_marginEnd="6dp"
                            android:importantForAccessibility="no"/>

                        <TextView
                            android:id="@+id/asistenciaHorario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14:00 – 16:00"
                            android:textColor="@color/purple_accent"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Recompensa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_coin"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/asistenciaRecompensa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+10 EduCoins si asististe"
                android:textColor="#333333"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Plazo -->
        <TextView
            android:id="@+id/asistenciaPlazo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Puedes responder hasta la medianoche (12:00 a. m.)"
            android:textAlignment="center"
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonAsisti"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Sí, asistí"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            app:backgroundTint="@color/purple_accent"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            android:layout_marginBottom="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonNoAsisti"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="No asistí"
            android:textColor="@color/purple_accent"
            android:textSize="17sp"
            android:textStyle="bold"
            app:strokeColor="@color/purple_accent"
            app:strokeWidth="2dp"
            app:cornerRadius="16dp"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonMasTarde"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Responder más tarde"
            android:textColor="#666666"
            android:textAllCaps="false"/>

    </LinearLayout>

</ScrollView>
