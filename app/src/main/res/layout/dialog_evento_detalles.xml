<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <View style="@style/Edu.AsaHoja"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/imageContainer"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/radio_tarjeta"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/eventoImagen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Imagen del evento"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/eventoTitulo"
            style="@style/Edu.Texto.TituloHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            
            android:text="Nombre del evento"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/labelDescripcion"
            style="@style/Edu.Texto.Rotulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/eventoDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción del evento"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:layout_marginBottom="14dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/time_row_bg"
            android:padding="12dp"
            android:layout_marginBottom="18dp">

            <TextView
                style="@style/Edu.Texto.Rotulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha"
                android:layout_marginBottom="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/baseline_calendar_month_24"
                    app:tint="@color/purple_accent"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:id="@+id/eventoFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01/01/2024"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/labelHorario"
                style="@style/Edu.Texto.Rotulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Horario"
                android:layout_marginBottom="2dp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/containerHorario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/purple_accent"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:id="@+id/eventoHorario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:00 - 12:00"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"/>
            </LinearLayout>

            <TextView
                style="@style/Edu.Texto.Rotulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prioridad"
                android:layout_marginBottom="2dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/prioridadIndicador"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/circle_shape"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:id="@+id/prioridadTexto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alta"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminar"
                style="@style/Edu.BotonContorno"
                android:layout_width="0dp"
                android:layout_height="@dimen/alto_boton"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Eliminar"
                android:textColor="@color/estado_error"
                app:strokeColor="@color/estado_error"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditar"
                style="@style/Edu.Boton"
                android:layout_width="0dp"
                android:layout_height="@dimen/alto_boton"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Editar"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrar"
            style="@style/Edu.BotonTexto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Cerrar"/>
    </LinearLayout>
</ScrollView>
