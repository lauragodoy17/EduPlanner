<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Atenúa la pantalla con el menú abierto; tocarlo lo cierra -->
    <View
        android:id="@+id/fab_velo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/velo_oscuro"
        android:clickable="true"
        android:focusable="false"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:gravity="end"
        android:paddingEnd="16dp"
        android:layout_above="@+id/botonAñadir"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/addTarea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView style="@style/Edu.FabEtiqueta" android:text="Añadir tarea"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/tareaB"
                style="@style/Edu.FabMini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Añadir tarea"
                android:src="@drawable/ic_gami_tarea" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/addEvento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView style="@style/Edu.FabEtiqueta" android:text="Añadir evento"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/eventoB"
                style="@style/Edu.FabMini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Añadir evento"
                android:src="@drawable/ic_gami_evento" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/addCalificacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView style="@style/Edu.FabEtiqueta" android:text="Añadir calificación"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/calificacionB"
                style="@style/Edu.FabMini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Añadir calificación"
                android:src="@drawable/ic_gami_nota" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/leerQR"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView style="@style/Edu.FabEtiqueta" android:text="Leer QR"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/qrB"
                style="@style/Edu.FabMini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Leer QR"
                android:src="@drawable/baseline_qr_code_24" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/botonAñadir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Añadir"
        android:src="@drawable/baseline_cruz_24"
        app:backgroundTint="@color/purple_accent"
        app:tint="@color/white"
        />
</RelativeLayout>
