<?xml version="1.0" encoding="utf-8"?>
<!-- Lo que llegó por QR: se revisa antes de agregarlo y, si su asignatura no existe aquí, se elige qué hacer -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <View style="@style/Edu.AsaHoja"/>

        <TextView
            android:id="@+id/importarTipo"
            style="@style/Edu.Texto.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            tools:text="TE COMPARTIERON UNA TAREA"/>

        <TextView
            android:id="@+id/importarTitulo"
            style="@style/Edu.Texto.TituloHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            tools:text="Taller de integrales"/>

        <LinearLayout
            android:id="@+id/importarDetalles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/time_row_bg"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="2dp"/>

        <!-- Destino: solo cuando la asignatura no existe en este teléfono -->
        <LinearLayout
            android:id="@+id/importarAsignatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/importarAsignaturaPregunta"
                style="@style/Edu.Texto.Rotulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                tools:text="No tienes la asignatura «Cálculo». ¿Qué quieres hacer?"/>

            <RadioGroup
                android:id="@+id/importarOpciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/importarCrear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="?attr/eduTextPrimary"
                    android:textSize="15sp"
                    app:buttonTint="?attr/eduAcento"
                    tools:text="Crear la asignatura"/>

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/importarUsarExistente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Asignarla a una que ya tengo"
                    android:textColor="?attr/eduTextPrimary"
                    android:textSize="15sp"
                    app:buttonTint="?attr/eduAcento"/>
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/importarNombreCaja"
                style="@style/Edu.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre de la nueva asignatura">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/importarNombre"
                    style="@style/Edu.CampoEntrada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/importarExistenteCaja"
                style="@style/Edu.CampoDesplegable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tu asignatura"
                android:visibility="gone">

                <AutoCompleteTextView
                    android:id="@+id/importarExistente"
                    style="@style/Edu.CampoEntrada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:padding="16dp"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/importarAviso"
            style="@style/Edu.Texto.Pie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:visibility="gone"
            tools:text="Se agregará a tu asignatura «Cálculo»"
            tools:visibility="visible"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importarAgregar"
            style="@style/Edu.Boton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_boton"
            tools:text="Agregar tarea"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importarCancelar"
            style="@style/Edu.BotonTexto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Cancelar"/>
    </LinearLayout>
</ScrollView>
