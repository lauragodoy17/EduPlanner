<?xml version="1.0" encoding="utf-8"?>
<!-- Entrada de una nota adaptada a la escala de la asignatura: deslizador con − / + para las numéricas, opciones para
     letras y aprobado/reprobado. Nunca deja escribir un valor fuera de la escala. La maneja Dialogs/EntradaCalificacion.kt -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notaEntrada"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/time_row_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/notaValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/eduAcento"
        android:textSize="44sp"
        android:textStyle="bold"
        tools:text="4,5" />

    <TextView
        android:id="@+id/notaEscala"
        style="@style/Edu.Texto.Pie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        tools:text="Escala de 1 a 5" />

    <!-- Numéricas: deslizador con botones para afinar -->
    <LinearLayout
        android:id="@+id/notaDeslizador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notaMenos"
            style="@style/Edu.BotonContorno"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Bajar la nota"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="−"
            android:textSize="22sp"
            app:cornerRadius="24dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/notaSlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="Calificación"
            app:haloColor="?attr/eduMarcaSuperficie"
            app:labelBehavior="gone"
            app:thumbColor="?attr/eduAcento"
            app:tickVisible="false"
            app:trackColorActive="?attr/eduAcento"
            app:trackColorInactive="?attr/eduMarcaSuperficie" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notaMas"
            style="@style/Edu.BotonContorno"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Subir la nota"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="+"
            android:textSize="22sp"
            app:cornerRadius="24dp" />
    </LinearLayout>

    <!-- Extremos de la escala bajo el deslizador -->
    <LinearLayout
        android:id="@+id/notaExtremos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="56dp">

        <TextView
            android:id="@+id/notaMinimo"
            style="@style/Edu.Texto.Pie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="1" />

        <TextView
            android:id="@+id/notaMaximo"
            style="@style/Edu.Texto.Pie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="5" />
    </LinearLayout>

    <!-- Letras y aprobado/reprobado: una opción por valor -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/notaOpciones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        app:selectionRequired="true"
        app:singleSelection="true" />
</LinearLayout>
