<?xml version="1.0" encoding="utf-8"?>
<!-- Editar, borrar y compartir: arriba a la derecha de la tarjeta de una tarea, evento, asignatura o nota.
     Los conecta configurarAccionesDetalle() -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/btnDetalleEditar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Editar"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_editar"
        android:tooltipText="Editar"
        app:tint="?attr/eduTextSecondary"/>

    <ImageButton
        android:id="@+id/btnDetalleBorrar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Borrar"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_borrar"
        android:tooltipText="Borrar"
        app:tint="?attr/eduTextSecondary"/>

    <ImageButton
        android:id="@+id/btnDetalleCompartir"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Compartir por QR"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_compartir"
        android:tooltipText="Compartir por QR"
        app:tint="?attr/eduTextSecondary"/>
</LinearLayout>
