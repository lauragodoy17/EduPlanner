<?xml version="1.0" encoding="utf-8"?>
<!-- Pregunta el área de una asignatura cuando su nombre no permitió detectarla (o encaja con varias) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_a"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <View style="@style/Edu.AsaHoja"/>

    <TextView
        android:id="@+id/areaTitulo"
        style="@style/Edu.Texto.TituloHoja"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        tools:text="¿A qué área pertenece Historia del arte?"/>

    <TextView
        android:id="@+id/areaDetalle"
        style="@style/Edu.Texto.Cuerpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        tools:text="«Historia del arte» encaja con Historia o Arte: elige la correcta"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/areaOpciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:singleSelection="true"/>

    <TextView
        style="@style/Edu.Texto.Pie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="Con el área, EduPlanner puede predecir cómo vas y qué método te conviene."/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/areaGuardar"
        style="@style/Edu.Boton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/alto_boton"
        android:enabled="false"
        android:text="Guardar"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/areaOmitir"
        style="@style/Edu.BotonTexto"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Ahora no"/>
</LinearLayout>
