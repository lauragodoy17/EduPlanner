<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.Inicio.Fragments.Asignaturas.AsignaturasFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margen_pantalla"
            android:paddingTop="16dp"
            android:paddingBottom="88dp">

            <!-- La acción va arriba para que el botón flotante no la tape -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/asignaturasResumen"
                    style="@style/Edu.Texto.Seccion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tus asignaturas"
                    android:accessibilityHeading="true"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonAgregarAsignatura"
                    style="@style/Edu.Boton.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Agregar"
                    android:textSize="14sp"
                    app:icon="@drawable/baseline_cruz_24"
                    app:iconSize="18dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerasignaturas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <!-- Sin asignaturas -->
            <LinearLayout
                android:id="@+id/textoAsignaturas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingTop="64dp"
                android:visibility="visible">

                <ImageView style="@style/Edu.VacioIcono" android:src="@drawable/baseline_asignatura_24" android:importantForAccessibility="no"/>

                <TextView
                    style="@style/Edu.VacioTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aún no hay asignaturas"/>

                <TextView
                    style="@style/Edu.VacioDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agrega la primera para armar tu horario"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
