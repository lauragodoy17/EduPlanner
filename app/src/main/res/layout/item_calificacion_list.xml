<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerReporte"
    style="@style/Edu.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="12dp"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <!-- La nota en su escala ("4,5", "85 %", "A", "Reprobado"): todas las pastillas del mismo ancho, para que los
             títulos queden alineados; el texto se achica solo si no cabe -->
        <TextView
            android:id="@+id/textOverlay"
            android:layout_width="96dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeTextType="uniform"
            android:background="@drawable/fondo_nota"
            android:backgroundTint="?attr/eduMarcaSuperficie"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="0"
            android:textColor="?attr/eduAcento"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_titulo"
                style="@style/Edu.Texto.TituloTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Asignatura"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/textodesc"
                style="@style/Edu.Texto.Cuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/Opciones"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Opciones"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/eduTextSecondary" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
