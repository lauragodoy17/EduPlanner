<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerReporte"
    style="@style/Edu.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="12dp"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <FrameLayout
            android:id="@+id/circleImageView"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="@color/purple_surface"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/textOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="0.0"
                android:textColor="@color/purple_accent"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_titulo"
                style="@style/Edu.Texto.TituloTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Asignatura"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/textodesc"
                style="@style/Edu.Texto.Cuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/Opciones"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Opciones"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
