<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerReporte"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="4dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Left colored bar for visual appeal -->
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/purple_accent"
            android:layout_marginEnd="12dp" />

        <!-- Grade circle -->
        <FrameLayout
            android:id="@+id/circleImageView"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/circle"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/textOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="0.0"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1" />
        </FrameLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Header Row with Subject and Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <!-- Subject Name -->
                <TextView
                    android:id="@+id/text_titulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Asignatura"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Type Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CALIFICACIÓN"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/type_badge_bg"
                    android:backgroundTint="@color/purple_accent"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/textodesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textSize="13sp"
                android:textColor="#666666"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Options Button -->
        <ImageButton
            android:id="@+id/Opciones"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Opciones"
            android:src="@drawable/baseline_trespuntos_vert_24"
            app:tint="#666666" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
